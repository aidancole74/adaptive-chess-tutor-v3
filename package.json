{
  "name": "adaptive-chess-tutor",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only adaptive chess training app",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sim": "tsx scripts/sim/run.ts",
    "data:tactics": "tsx scripts/tactics/build.ts",
    "data:endgames": "tsx scripts/endgames/build.ts",
    "data:openings": "tsx scripts/openings/build.ts",
    "data:strategy": "tsx scripts/strategy/build.ts",
    "data:manifest": "tsx scripts/manifest.ts",
    "data:qa": "tsx scripts/qa/report.ts",
    "commit": "tsx scripts/git.mts commit",
    "gitlog": "tsx scripts/git.mts log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "chess.js": "^1.4.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "isomorphic-git": "^1.44.12",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
